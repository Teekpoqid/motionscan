# Copy this to .env and edit. All values have defaults in docker-compose.yml except
# VIDEOS_HOST_PATH, which is required.

# Host folder containing the videos (mounted read/write at /videos in the container).
VIDEOS_HOST_PATH=/path/to/your/videos

# "dense" (hwaccel decode, sampled fps) or "fast" (CPU-only, keyframes only).
MODE=dense

# Scan subfolders too (true/false).
RECURSIVE=true

# Output CSV filename, written back into VIDEOS_HOST_PATH. Each profile also has its
# own default (dense_results_cuda.csv, dense_results_qsv.csv, ...) so runs don't clobber
# each other -- only set this if you want a specific name.
# OUT_FILE=dense_results.csv

# Sampling rate (frames/sec) for the dense scan.
FPS=2.0

# Downscale size used for frame-diffing (smaller = faster, less sensitive to small motion).
SCALE_W=160
SCALE_H=90

# Mean abs pixel diff (0-255 grayscale) that counts a sampled frame pair as "changed".
DIFF_THRESHOLD=2.0

# Fraction of changed frame pairs needed to classify a file as "motion".
FRAC_THRESHOLD=0.02

# Concurrent ffmpeg processes. Consumer NVIDIA GPUs cap concurrent NVDEC sessions
# (~3-5 on stock drivers) -- keep WORKERS low for the cuda profile. QSV/VAAPI and CPU
# software decode can go higher.
WORKERS=3

# Per-file ffmpeg timeout, seconds.
TIMEOUT=600

# Comma-separated extensions to scan.
EXTENSIONS=mkv,mp4

# VA-API render node (only used by the vaapi profile). List candidates on the host with
# `ls /dev/dri` if renderD128 isn't right.
VAAPI_DEVICE=/dev/dri/renderD128
